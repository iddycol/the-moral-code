{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-moral-code.example/schemas/scales/role-assessment-v0.1.json",
  "title": "The Scales v0.1 Role Assessment",
  "type": "object",
  "required": ["evaluation_id", "role", "role_contract_version", "findings", "principle_assessments", "recommended_disposition"],
  "properties": {
    "evaluation_id": {"type": "string"},
    "role": {"enum": ["advocate", "guardian", "evidence_sceptic", "power_auditor", "vulnerable_person_defender", "future_environment_advocate"]},
    "role_contract_version": {"type": "string"},
    "run_metadata": {
      "type": "object",
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "model_version": {"type": "string"},
        "prompt_or_contract_digest": {"type": "string"},
        "run_id": {"type": "string"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "statement", "basis"],
        "properties": {
          "finding_id": {"type": "string"},
          "statement": {"type": "string"},
          "basis": {"enum": ["input_evidence", "constitutional_interpretation", "inference", "hypothesis", "missing_information"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "materiality": {"enum": ["low", "medium", "high", "decisive"]}
        }
      }
    },
    "principle_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["principle_id", "status", "reason"],
        "properties": {
          "principle_id": {"pattern": "^MC-[0-9]{2}$"},
          "status": {"enum": ["pass", "concern", "fail", "uncertain", "not_applicable"]},
          "reason": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "potential_moral_floor_breach": {"type": "boolean"}
        }
      }
    },
    "information_requests": {"type": "array", "items": {"type": "string"}},
    "alternatives_or_safeguards": {"type": "array", "items": {"type": "string"}},
    "evidence_that_could_change_view": {"type": "array", "items": {"type": "string"}},
    "recommended_disposition": {"enum": ["permissible", "permissible_with_safeguards", "impermissible", "insufficient_evidence", "unresolved_conflict"]}
  }
}
