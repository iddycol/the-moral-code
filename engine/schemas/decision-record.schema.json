{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moral Code Decision Record",
  "type": "object",
  "required": [
    "decision_id",
    "proposal",
    "evidence",
    "affected_parties",
    "principle_assessments",
    "outcome"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "proposal": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "status"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "observed",
              "sourced",
              "inferred",
              "predicted",
              "unknown"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "affected_parties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "principle_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "principle_id",
          "status",
          "reason"
        ],
        "properties": {
          "principle_id": {
            "pattern": "^MC-[0-9]{2}$"
          },
          "status": {
            "enum": [
              "pass",
              "concern",
              "fail",
              "uncertain",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "moral_floor_breach": {
      "type": "boolean"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_that_could_change_result": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "enum": [
        "permissible",
        "permissible_with_safeguards",
        "impermissible",
        "insufficient_evidence",
        "unresolved_conflict"
      ]
    },
    "reasoning_summary": {
      "type": "string"
    }
  }
}
