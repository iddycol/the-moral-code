{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-moral-code.example/schemas/historical-repair-packet-v0.1.json",
  "title": "Historical Crucible Repair Packet v0.1",
  "type": "object",
  "required": [
    "repair_case_id",
    "identity_mode",
    "repair_context",
    "repair_question",
    "established_harms",
    "responsible_actors",
    "affected_parties",
    "continuing_risks",
    "repair_options",
    "constraints",
    "uncertainties",
    "requested_output"
  ],
  "properties": {
    "repair_case_id": {"type": "string", "pattern": "^RC-[0-9]{4}$"},
    "identity_mode": {"enum": ["transparent", "masked"]},
    "repair_context": {"type": "string", "minLength": 1},
    "repair_question": {"type": "string", "minLength": 1},
    "established_harms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["harm_id", "description", "status"],
        "properties": {
          "harm_id": {"type": "string"},
          "description": {"type": "string"},
          "status": {"enum": ["established", "substantially_established", "disputed", "unknown"]},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "responsible_actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["actor", "responsibility_status"],
        "properties": {
          "actor": {"type": "string"},
          "responsibility_status": {"enum": ["institutional_established", "individual_established", "attributed", "disputed", "successor_institution", "not_personally_responsible"]},
          "responsibility_note": {"type": "string"}
        }
      }
    },
    "affected_parties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["party", "interests"],
        "properties": {
          "party": {"type": "string"},
          "interests": {"type": "string"},
          "expressed_preferences": {"type": "array", "items": {"type": "string"}},
          "preference_diversity_note": {"type": "string"},
          "power_position": {"enum": ["very_low", "low", "mixed", "high", "very_high", "unknown"]}
        }
      }
    },
    "continuing_risks": {"type": "array", "items": {"type": "string"}},
    "repair_options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["option_id", "type", "description"],
        "properties": {
          "option_id": {"type": "string"},
          "type": {"enum": ["protection", "truth_acknowledgement", "restitution", "compensation", "rehabilitation", "accountability", "restriction", "institutional_reform", "non_recurrence", "memorialisation", "reconciliation", "amnesty", "other"]},
          "description": {"type": "string"},
          "feasibility": {"enum": ["known_feasible", "possibly_feasible", "known_infeasible", "unknown"]},
          "victim_control_note": {"type": "string"}
        }
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "citation"],
        "properties": {
          "source_id": {"type": "string"},
          "citation": {"type": "string"},
          "url": {"type": "string"},
          "source_date": {"type": "string"},
          "quality_note": {"type": "string"}
        }
      }
    },
    "requested_output": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
